http:
  mitm:
  - cn-acs.m.cainiao.com
  - goblin.hupu.com
  - pan.baidu.com
  url-rewrite:
  - ^https://pan\.baidu\.com/buy/ad/(?:conf|get|analytics)(?:[/?]|$) - reject-dict
  - ^https://pan\.baidu\.com/rest/[0-9]+\.[0-9]+/pcs/ad(?:v|x)?(?:[/?]|$) - reject-dict
  - ^https://pan\.baidu\.com/rest/2\.0/membership/advertise/dsp(?:[/?]|$) - reject-dict
  - ^https://pan\.baidu\.com/api/analytics\?(?:[^&#]*&)*[A-Za-z0-9_]+\x3d[^&#]*(?:splash|bidding)[^&#]*(?:[&#]|$) - reject-dict
  - ^https?://cn-acs\.m\.cainiao\.com/gw/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?:show|mshow)\.cn(?:[/?]|$) - reject-200
  - ^https?://goblin\.hupu\.com/(?:[^/?]+/)+interfaceAd/getOther(?:[/?]|$) - reject-200
  - ^https?://pan\.baidu\.com/rest/2\.0/pcs/ad(?:[/?]|$) - reject-200
  - ^https://pan\.baidu\.com/buy/ad/conf\?(?:[^&#]*&)*type\x3dsplashMode(?:[&#]|$) - reject-dict
